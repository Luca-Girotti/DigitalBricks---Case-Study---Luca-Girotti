# Copy this file to .env and fill in the real values.
# The .env file is gitignored and must never be committed.
#
#   cp .env.example .env

# The base URL of your Azure OpenAI or Azure AI Foundry resource.
# Looks like: https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# The API key for that resource (Azure portal -> Keys and Endpoint).
AZURE_OPENAI_API_KEY=

# The API version to target. Safe to leave as-is.
AZURE_OPENAI_API_VERSION=2024-10-21

# The *deployment name* you chose in Azure for the chat model,
# not the model name. E.g. you might deploy "gpt-4o" as "chat".
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# The deployment name for the embedding model, used to turn both the
# knowledge base chunks and the user's query into vectors.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
